{
	// Enable the multishot ability when wearing the skull
	enableSkullMultishot: true,
	// Enable the faster bow draw speed when wearing the chestplate
	enableChestplateDrawSpeed: true,
	// Enable the crossbow tweaks when wearing the chestplate
	enableChestplateCrossbowTweak: true,
	// Enable jump boost when wearing the leggings
	enableLeggingsEffect: true,
	// Enable speed when wearing the boots
	enableBootsEffect: true
}