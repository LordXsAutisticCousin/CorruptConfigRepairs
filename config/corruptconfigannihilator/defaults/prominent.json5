  // --------------------------------------------------
  //                     General
  // --------------------------------------------------
  // Dimensions where non-creative players cannot use ability flight or fall-flying
  "creative_flight_disabled_dimensions": [
    "prominent:vaaz_past",
    "prominent:vaaz_present",
    "prominent:vaaz_assault"
  ],
  // Per-dimension movement speed caps. max_speed is a multiplier of the vanilla player base speed.
  // Example: 1.5 allows up to 150% of the default player movement speed in that dimension.
  "dimension_speed_limits": [
    {
      "dimension": "prominent:vaaz_past",
      "max_speed": 1.5
    },
    {
      "dimension": "prominent:vaaz_present",
      "max_speed": 1.5
    },
    {
      "dimension": "prominent:vaaz_assault",
      "max_speed": 1.5
    }
  ],
  // --------------------------------------------------
  //                     Items
  // --------------------------------------------------
  //  Thunderwrath
  // --------------------------------------------------
  "thunderwrath_damage": 16.0,
  "thunderwrath_attackSpeed": -2.6
}