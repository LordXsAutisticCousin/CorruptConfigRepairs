// This config file uses a custom defined parser.
//   That's why there are comments here and stray values below, they wouldn't be valid in any other .json file
//   To add a comment yourself, just start a line with // like here

version: 9.0
reset: false

// OVERCHARGE
"overcharge": {
  // Default overcharge configs, unless custom behavior is set for a staff
  //   by following the same structure in `cost.overcharge`
  
  // Maximal overcharge a staff can hold at any given time
  "max": 20,
  // Color for the overcharge bar. Hexadecimal format
  "bar_color": "0x0000ff",
  // Should overcharged staffs ignore durability cost when firing
  "ignore_durability": true,
  // Should overcharged staffs ignore resource cost when firing
  "ignore_cost": true,
  // If true, staffs can't be fired unless they have overcharge
  "required": false,
  // Which items can be used to overcharge staffs. Must be formatted as "modid:itemid": value
  "ingredients": {
    "minecraft:lapis_lazuli": 2,
    "minecraft:lapis_block": 20
  }
},

// BEHAVIOR
"behavior": {
  // If true, staff beams will pass through blocks up to their pierce value
  "pierce_blocks": false
},

// ENTRIES
"entries": []
