{
  // --- CLIENT-SIDE CONFIG ---
  //
  // Sets the position of the mana display
  // The x-offset is subtracted from the x pos of the middle of the screen. (Ex: 0 would make it right in the middle)
  // The y-offset is subtracted from the y pos at the bottom of the screen. (Ex: 0 would make it at the very bottom of the screen)
  // X-Offset Default: 180
  // Y-Offset Default: 15
  "mana_xoffset": 250,
  "mana_yoffset": 15,
  // Determines whether mana should only display if you have a mana item in your hand.
  // Accepts "true" or "false"
  // Default: false (always shows mana)
  "displayManaWithItem": true,
  // Determines whether a sound should be played when using a channeler
  // Accepts "true" or "false"
  // Default: true
  "play_channel_sound": true,
  // Whether screen shaking should be enabled or not. Used for players hit with the Rumble spell.
  // Accepts "true" or "false"
  // Default: true
  "enableScreenShake": false,
  // An integer value that is factored into the Soul Power scaling function to calculate soul power from number of souls in a Staff of Undead
  //The greater the value (ex. 50), the HARDER it will be to increase your Soul Power (more souls needed for each level)
  //The smaller the value (ex. 5), the EASIER it will be to increase your Soul Power (less souls needed for each level)
  //The number should follow these bounds: 1 <= x <= 100
  //Default: 10
  "soulPowerScaling": 10,
  //
  // --- SERVER-SIDE CONFIG ---
  //
  // --- World Generation ---
  //
  // Weight/Chance for the Wizard Village House to spawn in villages
  // Default: 10
  "wizard_village_weight": 10,
  // Enable or disable cloud generation.
  // Accepts "true" or "false"
  // Default: true
  "enableCloudGeneration": true,
  //
  // --- Player Mana ---
  //
  // The amount of game ticks needed to regen exactly 1 mana. (Less is faster regen)
  // Accepts integers.
  // Default: 4
  "manaRegenTickAmount": 4,
  //
  // --- Scrolls ---
  //
  // The amount of mana a Capacity Scroll adds to the player.
  // Accepts integers.
  // Default: 100
  "capacityScrollAddAmount": 100,
  // How much faster the player regenerates mana when using an Accelerate Scroll.
  // Formula: round(manaRegenTickAmount / accelerateScrollMultiplier)
  // Accepts decimals.
  // Default: 2
  "accelerateScrollMultiplier": 2.0,
  //
  // --- Items ---
  //
  // The max amount of experience the experience pouches can hold.
  // Accepts integers.
  // Default: 550 (Regular)
  // Default: 2920 (Super)
  "experiencePouchMax": 550,
  "superExperiencePouchMax": 2920,
  // The chance that Harvesters will drop the bonus related to the mob
  // The number should follow these bounds: 0 <= x <= 1.0
  // Default: 0.05 (1/20)
  "harvester_chance": 0.05,
  // terraneanAxeManaCost:
  // Mana cost for the Terranean Axe's ability.
  // Accepts integers.
  // Default: 40
  // terraneanAxeResistanceAmplifier:
  // Resistance amplifier for the Terranean Axe's ability.
  // Accepts integers.
  // Default: 2
  // terraneanAxeEffectDuration:
  // Effect duration for the Terranean Axe's ability.
  // Accepts decimals.
  // Default:
  // {
  //   "resistance": 20.0,
  //   "sturdy": 20.0
  // }
  "terraneanAxeManaCost": 40,
  "terraneanAxeResistanceAmplifier": 0,
  "terraneanAxeEffectDuration": {
    "sturdy": 2.0,
    "resistance": 7.5
  },
  //
  // --- Enchantments ---
  //
  // The mana reduction multiplier that each level of the Arcane enchantment adds.
  // Default: 0.1 (10%)
  "arcaneEnchantmentLevelMultiplier": 0.1,
  //
  // --- Spells ---
  //
  // Enable or disable specific spells.
  // Accepts "true" or "false"
  // Example: "fireball": false to disable Fireball
  // Default: true
  "enabledSpells": {
    "overcast": true,
    "shadow": false,
    "astrofall": true,
    "thunder_strike": false,
    "cloudshot": true,
    "ender": true,
    "aqua_shield": true,
    "spike": false,
    "freeze": true,
    "propel": true,
    "crush": true,
    "vacuum": true,
    "hellbeam": false,
    "fireball": false,
    "clearing_breeze": true,
    "bubble_beam": true,
    "swap": false,
    "terrain_toss": true,
    "rage": false,
    "darkball": false,
    "scorch": false,
    "mend": true,
    "rumble": true,
    "incombustible": false,
    "gust": true,
    "warp": true
  },
  // Change specific spells' mana cost.
  // Accepts integers.
  // Example: "fireball": 40 to set Fireball's mana cost to 40.
  "spellManaCost": {
    "overcast": 90,
    "shadow": 70,
    "astrofall": 80,
    "thunder_strike": 30,
    "cloudshot": 10,
    "ender": 20,
    "aqua_shield": 100,
    "spike": 20,
    "freeze": 10,
    "propel": 10,
    "crush": 2,
    "vacuum": 50,
    "hellbeam": 10,
    "fireball": 20,
    "clearing_breeze": 90,
    "bubble_beam": 10,
    "swap": 40,
    "terrain_toss": 10,
    "rage": 40,
    "darkball": 10,
    "scorch": 30,
    "mend": 40,
    "rumble": 40,
    "incombustible": 50,
    "gust": 20,
    "warp": 10
  },
  // spellEffectDuration:
  // - Change the duration of effects given by spells (in seconds).
  // - Accepts decimals.
  // spellEffectAmplifier:
  // - Change the amplifier of effects given by spells (level - 1).
  // - Accepts integers.
  "spellEffectDuration": {
    "shadow": 10.0,
    "rage": 7.0,
    "incombustible": 60.0,
    "aqua_shield": 10.0
  },
  "spellEffectAmplifier": {
    "rage": 0,
    "aqua_shield": 1
  },
  // The bonus multiplier for spell power to add to the effect's timer.
  // Formula (result in seconds): effectDuration = effectDuration + spellPower * spellEffectDurationMultiplier
  // Default: 2.0
  "spellEffectDurationMultiplier": 0.2,
  // enableAlternateMendScalingFormula:
  // - Enables the alternate mend spell scaling formula
  // - heal = maxPlayerHealth * maxMendHealingPercentage * min(maxBonusHealingMultiplier, 1 + mendSpellScaling * ln(1 + max(spellPower - minMendSpellPower, 0)))
  // - Default: false
  // Mend spell config - No effect if the alternate formula is disabled.
  // maxMendHealingPercentage:
  // - Maximum amount of health that can be restored by one use of the Mend spell.
  // - Default: 0.1
  // maxBonusHealingMultiplier:
  // - Maximum bonus healing multiplier from additional spell power for maxMendHealingPercentage.
  // - Default: 1.1
  // mendSpellScaling:
  // - Spell power coefficient which the Mend spell scales with in the alternate formula.
  // - Default: 0.03
  // minMendSpellPower:
  // - Minimum spell power to apply bonus healing when using the Mend spell.
  // - Default: 5
  "enableAlternateMendScalingFormula": true,
  "maxMendHealingPercentage": 0.1,
  "maxBonusHealingMultiplier": 1.1,
  "mendSpellScaling": 0.03,
  "minMendSpellPower": 5.0,
  //
  //--- Summons ---
  //
  // Enable or disable specific soul summons.
  // Accepts "true" or "false"
  // Example: "hound_pack": false to disable Hound Pack
  // Default: true
  "enabledSummons": {
    "deathstrider": false,
    "silver_swarm": false,
    "twin_knights": false,
    "hound_pack": false,
    "archer": false,
    "titan": false
  }
}
