{
  // Master toggle for client-side attribute modifier tooltip reordering
  "enabled": true,
  // Lower numbers appear higher in the tooltip
  // Max health is always forced to the bottom and does not use these priorities
  "armor_priority": 0,
  // Priority for spell school attributes like fire, frost, arcane, soul, healing, and lightning
  "spell_power_priority": 2,
  // Priority for spell critical chance and spell critical damage
  "spell_critical_priority": 3,
  // Priority for generic combat and mobility attributes like attack damage, attack speed, armor toughness, and movement speed
  "generic_priority": 4,
  // Priority for any other recognized attribute modifier line
  "other_priority": 5
}