{
  // Prismatic Shift (2p): bonus damage in % for the other two elements after casting an elemental spell
  "prismatic_shift_bonus_percent": 15.0,
  // Prismatic Shift (2p): buff duration in seconds
  "prismatic_shift_duration_seconds": 5.0,
  // Cosmic Convergence (4p): window in seconds within which Fire, Frost and Arcane damage must all land (also the internal cooldown)
  "cosmic_convergence_window_seconds": 8.0,
  // Cosmic Convergence (4p): explosion damage as a % of the Fire/Frost/Arcane spell damage dealt during the window
  "cosmic_convergence_damage_percent": 15.0,
  // Prismatic Focus (2p): bonus damage in % for the element of the invocation cast
  "prismatic_focus_bonus_percent": 20.0,
  // Prismatic Focus (2p): buff duration in seconds
  "prismatic_focus_duration_seconds": 12.0,
  // Woven Elements (4p): bonus damage in % for big spells while all three Prismatic Focus buffs are active (100 = double damage)
  "woven_elements_bonus_percent": 100.0,
  // Spell ids that count as a big spell from the Astral Invocations (the invoked combo finishers)
  "big_spell_ids": [
    "invoke:armageddon",
    "invoke:combustion",
    "invoke:greater_fireball",
    "invoke:supernova",
    "invoke:flameray",
    "invoke:meteorrush",
    "invoke:buckshot",
    "invoke:scorchingwind",
    "invoke:flame_geyser",
    "invoke:agonizingblast",
    "invoke:amethystburst",
    "invoke:sonicboom",
    "invoke:magic_missile",
    "invoke:magic_missile2",
    "invoke:enders_gaze",
    "invoke:eldritch_blast",
    "invoke:eldritch_blasts",
    "invoke:hijack",
    "invoke:blink",
    "invoke:glacier",
    "invoke:icebarrage",
    "invoke:icestorm",
    "invoke:deathchill",
    "invoke:upheaval",
    "invoke:glacialhammer",
    "invoke:sharedsuffering",
    "invoke:frozen_resonance",
    "invoke:freezeaura"
  ],
  // Astral Overload (2p): bonus damage in % for Supernova's elemental novas
  "astral_overload_nova_bonus_percent": 30.0,
  // Astral Overload (2p): movement speed bonus in % granted when a nova procs
  "astral_overload_speed_percent": 10.0,
  // Astral Overload (2p): movement speed buff duration in seconds
  "astral_overload_speed_duration_seconds": 3.0,
  // Astral Detonation (4p): maximum bonus each of Fire and Frost can add to Astral Burst, as a multiple of the arcane hit (1.5 = 150%)
  "astral_detonation_max_school_ratio": 1.5
}