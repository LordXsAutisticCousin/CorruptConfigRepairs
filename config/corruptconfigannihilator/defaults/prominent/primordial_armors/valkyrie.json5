{
  // Increase in % applied to the player's Lightning power inside the set's damage formulas (120 = base x2.2)
  "set_lightning_increase_percent": 120.0,
  // Storm Strikes (2p): every Nth melee attack summons the lightning strike
  "storm_strikes_every_hits": 4,
  // Storm Strikes (2p): strike damage as a multiplier of the increased Lightning power (1.0 = 100%)
  "storm_strikes_lightning_multiplier": 1.0,
  // Storm Strikes (2p): stun duration in seconds
  "storm_strikes_stun_duration_seconds": 0.5,
  // Wrath of the Heavens (4p): thunderclap physical damage as a multiplier of your attack damage (2.5 = 250%)
  "wrath_physical_attack_damage_multiplier": 2.5,
  // Wrath of the Heavens (4p): thunderclap lightning damage as a multiplier of the increased Lightning power
  "wrath_lightning_multiplier": 2.5,
  // Wrath of the Heavens (4p): thunderclap radius in blocks around the stunned target
  "wrath_radius": 4.0,
  // Wrath of the Heavens (4p): internal cooldown in seconds (prevents one stun from double-proccing)
  "wrath_internal_cooldown_seconds": 2.0,
  // Stormsurge: movement speed and attack speed bonus in %
  "stormsurge_bonus_percent": 15.0,
  // Stormsurge: duration in seconds
  "stormsurge_duration_seconds": 5.0,
  // Stormsurge: radius in blocks around the player in which allies also receive the buff
  "stormsurge_ally_radius": 8.0
}