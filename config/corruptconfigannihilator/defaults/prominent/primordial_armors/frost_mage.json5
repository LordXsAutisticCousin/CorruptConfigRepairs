{
  // Frostbitten (2p): movement slow (in %) applied to targets hit by your frost spells
  "frostbitten_slow_percent": 20.0,
  // Frostbitten (2p): duration of the slow, in seconds (refreshed on every frost spell hit)
  "frostbitten_slow_duration_seconds": 3.0,
  // Frostbitten (2p): bonus frost damage (in %) taken by targets while slowed by Frostbitten
  "frostbitten_bonus_frost_damage_percent": 20.0,
  // Weakening Frost (4p): the Frostbitten slow is increased to this value (in %)
  "weakening_frost_slow_percent": 50.0,
  // Weakening Frost (4p): extra frost damage (in %) taken while slowed, on top of the Frostbitten bonus
  "weakening_frost_extra_frost_damage_percent": 7.5,
  // Weakening Frost (4p): extra physical damage (in %) taken while slowed
  "weakening_frost_extra_physical_damage_percent": 15.0,
  // Chilling Winds (2p): movement slow (in %) applied when your frost spells critically hit
  "chilling_winds_slow_percent": 50.0,
  // Chilling Winds (2p): duration of the slow, in seconds
  "chilling_winds_duration_seconds": 2.0,
  // Shatter Point (4p): explosion damage as a multiplier of your frost spell power (9.0 = 900%)
  "shatter_point_frost_power_multiplier": 9.0,
  // Shatter Point (4p): explosion radius in blocks
  "shatter_point_radius": 4.0,
  // Shatter Point (4p): cooldown in seconds
  "shatter_point_cooldown_seconds": 7.0,
  // Rapid Chill (2p): movement slow (in %) per Frostbite mark
  "frostbite_mark_slow_percent_per_mark": 5.0,
  // Rapid Chill (2p): maximum number of Frostbite marks
  "frostbite_mark_max_marks": 10,
  // Rapid Chill (2p): mark duration in seconds (refreshed whenever a mark is applied)
  "frostbite_mark_duration_seconds": 6.0,
  // Runic Execution (4p): the consuming Frostmourne melee hit is multiplied by this value (4.0 = 400%)
  "runic_execution_damage_multiplier": 4.0,
  // Runic Execution (4p): Haste amplifier granted on execution (1 = Haste II)
  "runic_execution_haste_amplifier": 1,
  // Runic Execution (4p): Haste duration in seconds
  "runic_execution_haste_duration_seconds": 5.0,
  // Runic Execution (4p): radius in blocks around the player in which allies also receive Haste
  "runic_execution_ally_radius": 8.0
}