{
  // Plaguebearer (2p): physical damage increase in % per plague stack on the victim
  "plaguebearer_damage_per_stack_percent": 2.0,
  // Plaguebearer (2p): seconds between infection pulses
  "plaguebearer_interval_seconds": 7.0,
  // Plaguebearer (2p): infection pulse radius in blocks
  "plaguebearer_radius": 4.0,
  // Epidemic (4p): plague stacks per application instead of 1 (applies to the pulse and mirrored spells)
  "epidemic_stacks_per_application": 2,
  // Epidemic (4p): Plaguebearer pulse radius increase in %
  "epidemic_radius_increase_percent": 40.0,
  // Epidemic (4p): spell casts that additionally apply plague stacks to their targets (best-effort mirror of the Death Knights mod's own applications; festering wound bursts cannot be mirrored)
  "epidemic_mirror_spell_ids": [
    "death_knights:death_coil"
  ]
}