{
  // Scorching Heat (2p): % of each fire spell hit dealt again as Burn over the duration
  "scorching_heat_burn_percent": 10.0,
  // Scorching Heat (2p): duration in seconds of the Burn
  "scorching_heat_duration_seconds": 4.0,
  // Living Bomb (4p): % chance for a fire spell hit on a burning enemy to detonate them
  "living_bomb_chance_percent": 30.0,
  // Living Bomb (4p): explosion damage as % of the triggering spell hit
  "living_bomb_explosion_percent_of_hit": 60.0,
  // Living Bomb (4p): explosion radius in blocks
  "living_bomb_radius": 4.0,
  // Inner Power (2p): % of damage done to a target stored as Inner Power
  "inner_power_stack_percent": 5.0,
  // Inner Power (2p): sliding window in seconds over which stored damage is kept
  "inner_power_window_seconds": 20.0,
  // Inner Power (2p): % of the stored damage burned per interval
  "inner_power_burn_percent": 1.0,
  // Inner Power (2p): % of the stored damage burned per interval while channeling Fire Breath
  "inner_power_burn_percent_fire_breath": 2.0,
  // Inner Power (2p): burn interval in seconds
  "inner_power_burn_interval_seconds": 2.0,
  // Combustion (4p): cooldown in seconds
  "combustion_cooldown_seconds": 30.0,
  // Combustion (4p): window in seconds after casting Meteor during which the next hit unleashes the stored damage
  "combustion_window_seconds": 5.0,
  // Twin Resonance (2p): bonus fire damage in % while resonating
  "twin_resonance_fire_bonus_percent": 15.0,
  // Twin Resonance (2p): duration in seconds of the buff
  "twin_resonance_duration_seconds": 5.0,
  // Solar Mastery (4p): flare damage as a multiplier of your fire spell power (8.0 = 800%)
  "solar_mastery_flare_fire_multiplier": 8.0,
  // Solar Mastery (4p): flare impact radius in blocks
  "solar_mastery_flare_radius": 5.0,
  // Solar Mastery (4p): seconds added to the active Solar Eclipse per flare
  "solar_mastery_eclipse_extension_seconds": 2.0,
  // Solar Mastery (4p): internal cooldown in seconds between flares
  "solar_mastery_internal_cooldown_seconds": 5.0,
  // Soulfire Edge (2p): bonus melee and fire spell damage in % while holding at least one Broken Soul stack
  "soulfire_edge_bonus_percent": 15.0,
  // A'zhar's Gluttony (4p): burst damage as % of your missing health when a Broken Soul expires
  "gluttony_missing_health_percent": 15.0,
  // A'zhar's Gluttony (4p): burst radius in blocks
  "gluttony_radius": 5.0
