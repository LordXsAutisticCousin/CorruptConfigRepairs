{
  // Aura of Protection (2p): aura radius in blocks around the wearer
  "aura_radius": 5.0,
  // Aura of Protection (2p): % less damage taken by allies inside the aura (does not stack between paladins)
  "aura_damage_reduction_percent": 10.0,
  // Aura of Protection (2p): % Holy Power gained per ally inside the aura
  "aura_holy_power_percent_per_ally": 5.0,
  // Aura of Protection (2p): maximum % Holy Power gained from the aura
  "aura_holy_power_max_percent": 20.0,
  // Divine Shield (4p): continuous seconds in combat required to trigger
  "divine_shield_combat_seconds": 5.0,
  // Divine Shield (4p): immunity duration in seconds
  "divine_shield_duration_seconds": 3.0,
  // Divine Shield (4p): cooldown in seconds; the combat timer only starts counting again once the cooldown is over
  "divine_shield_cooldown_seconds": 45.0,
  // Divine Shield (4p): radius in blocks to search for the closest ally to shield
  "divine_shield_ally_radius": 10.0
}