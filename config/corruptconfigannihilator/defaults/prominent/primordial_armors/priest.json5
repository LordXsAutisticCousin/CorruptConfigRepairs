{
  // Resonating Punishment (2p): % of the healed amount dealt as holy damage to the nearest enemy
  "resonance_damage_percent": 10.0,
  // Resonating Punishment (2p): radius in blocks used to find the nearest enemy
  "resonance_search_radius": 16.0,
  // Savior (4p): ally health threshold in % below which heals are amplified
  "savior_low_health_threshold_percent": 20.0,
  // Savior (4p): heal multiplier on low-health allies (3.0 = 200% more effective)
  "savior_heal_multiplier": 3.0,
  // Savior (4p): Resonating Punishment damage multiplier against undead
  "savior_undead_resonance_multiplier": 2.0
}