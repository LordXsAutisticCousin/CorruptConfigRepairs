{
  // Master toggle for the magic resistance attribute
  "enabled": true,
  // Formula that returns final damage after magic resistance is applied
  // Available variables: damage, magic_resistance, magicResistance, resistance
  // Available constants: pi, e
  // Supported operators: +, -, *, /, %, ^, and parentheses
  // Available functions: min(a,b), max(a,b), clamp(x,min,max), abs(x), sqrt(x), pow(a,b), floor(x), ceil(x), round(x)
  // Default formula matches vanilla armor math without armor toughness
  "formula": "damage * (1 - clamp(magic_resistance - damage / 2.0, magic_resistance * 0.2, 20.0) / 25.0)"
}