{
  // Master toggle for granting default spells to weapons that lack one
  "enabled": true,
  // When true, an equipped spellbook fully replaces the default spell (strict either/or)
  // When false, the default spell is merged together with the spellbook's spells (like swords)
  "suppress_when_spellbook_equipped": true,
  // Weapon-to-spell rules, evaluated top to bottom; the first matching rule wins.
  // Each rule:
  //   match        - BETTER_COMBAT_CATEGORY (uses 'categories' + 'handedness'),
  //                  or RANGED_WEAPON (vanilla bow/crossbow and any modded RangedWeaponItem;
  //                  this is Spell Engine's own archery weapon definition, so Better Combat
  //                  does not need to categorise the weapon)
  //   categories   - Better Combat categories to match (only for BETTER_COMBAT_CATEGORY)
  //   handedness   - ANY, ONE_HANDED or TWO_HANDED (only for BETTER_COMBAT_CATEGORY)
  //   spell_ids    - spells granted by this rule
  //   content_type - MAGIC or ARCHERY (use ARCHERY for bows/crossbows)
  "rules": [
    {
      "match": "BETTER_COMBAT_CATEGORY",
      "categories": [
        "dagger"
      ],
      "handedness": "ANY",
      "spell_ids": [
        "rogues:throw"
      ],
      "content_type": "MAGIC"
    },
    {
      "match": "BETTER_COMBAT_CATEGORY",
      "categories": [
        "sword"
      ],
      "handedness": "ONE_HANDED",
      "spell_ids": [
        "rogues:charge"
      ],
      "content_type": "MAGIC"
    },
    {
      "match": "RANGED_WEAPON",
      "categories": [],
      "handedness": "ANY",
      "spell_ids": [
        "archers:power_shot",
        "archers:barrage"
      ],
      "content_type": "ARCHERY"
    }
  ]
}