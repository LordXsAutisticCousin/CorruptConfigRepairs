  // Prefer using prominent/combat_leap_weapons.json5 or /combatleap weapon ... instead
  "weapon_definitions": [],
  // Animation-specific leap multipliers
  // item_id and item_tag are optional; leave both null to match that animation for any weapon
  "animation_definitions": []
}