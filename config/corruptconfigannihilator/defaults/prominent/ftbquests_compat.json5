{
  // Fallback texture used when a category has no explicit background entry
  "default_background": "prominent:textures/ftbquests/backgrounds/default.png",
  // Opacity of the tiled background. 0.0 = invisible, 1.0 = fully opaque
  "background_opacity": 1.0,
  // Scale applied to each repeated tile.
  "background_scale": 2.0,
  // Horizontal pixel offset applied before tiling
  "background_offset_x": 0.0,
  // Vertical pixel offset applied before tiling
  "background_offset_y": 0.0,
  // If true, the tiled background also shows through the left and right sidebar panels
  "affect_sidebars": true,
  // Category-specific background overrides
  // category_id matches the chapter filename, and also accepts the internal numeric chapter id as a string
  "category_backgrounds": []
}